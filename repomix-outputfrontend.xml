* {
  box-sizing: border-box;
}

html,
body,
#root {
  height: 100%;
  margin: 0;
  overflow: hidden;
}

/* Login page needs to scroll on short / landscape viewports */
html:has(.ai-login-page),
body:has(.ai-login-page),
#root:has(.ai-login-page) {
  height: auto;
  min-height: 100%;
  overflow-x: hidden;
  overflow-y: auto;
}

#root {
  display: flex;
  flex-direction: column;
}

button,
input,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: grid;
  grid-template-columns: 300px 1fr;
  height: 100dvh;
  min-height: 0;
  overflow: hidden;
  padding-top: var(--safe-top);
  padding-right: var(--safe-right);
  padding-bottom: var(--safe-bottom);
  padding-left: var(--safe-left);
}

.sidebar-backdrop {
  display: none;
}

@media (max-width: 900px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .sidebar {
    display: none;
  }

  .sidebar.open {
    display: flex;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 50;
    width: min(320px, 88vw);
    padding-top: var(--safe-top);
    padding-bottom: var(--safe-bottom);
    padding-left: var(--safe-left);
    box-shadow: 8px 0 32px rgba(0, 0, 0, 0.35);
  }

  .sidebar-backdrop {
    display: block;
    position: fixed;
    inset: 0;
    z-index: 45;
    border: 0;
    padding: 0;
    margin: 0;
    background: rgba(15, 23, 42, 0.55);
    backdrop-filter: blur(2px);
    cursor: pointer;
  }

  .mobile-menu-btn,
  .mobile-sidebar-close {
    display: inline-grid;
    place-items: center;
  }
}

.sidebar {
  background: linear-gradient(180deg, var(--bg-sidebar) 0%, var(--bg-sidebar-end) 100%);
  border-right: 1px solid var(--border-dark);
  display: flex;
  flex-direction: column;
  color: var(--text-inverse);
  min-height: 0;
  overflow: hidden;
}

.sidebar-header {
  padding: 1.25rem 1rem 1rem;
  border-bottom: 1px solid var(--border-dark);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.mobile-menu-btn,
.mobile-sidebar-close {
  display: none;
  width: 2.4rem;
  height: 2.4rem;
  border: 0;
  border-radius: 8px;
}

.mobile-menu-btn {
  background: var(--accent-soft);
  color: var(--accent-text);
}

.mobile-sidebar-close {
  background: var(--bg-panel);
  color: var(--text-inverse);
  font-size: 1.5rem;
}

@media (max-width: 900px) {
  .mobile-menu-btn,
  .mobile-sidebar-close {
    display: inline-grid;
    place-items: center;
  }
}

.brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.brand-logo {
  width: 42px;
  height: 42px;
  border-radius: 12px;
  object-fit: contain;
  background: white;
  padding: 4px;
  box-shadow: var(--shadow-accent);
  flex-shrink: 0;
}

.brand-logo-lg {
  width: 72px;
  height: 72px;
  border-radius: 16px;
  object-fit: contain;
  background: white;
  padding: 6px;
  box-shadow: var(--shadow-accent);
  margin: 0 auto 1rem;
  animation: brand-float 4.5s ease-in-out infinite;
}

.brand h1 {
  margin: 0;
  font-size: 1.05rem;
  font-weight: 700;
  font-family: var(--font-display);
  letter-spacing: -0.02em;
}

.brand p {
  margin: 0.15rem 0 0;
  font-size: 0.75rem;
  color: var(--text-muted-inv);
}

.sidebar-actions {
  display: flex;
  gap: 0.5rem;
  padding: 0.85rem 1rem;
}

.btn {
  border: none;
  border-radius: var(--radius-sm);
  padding: 0.65rem 0.9rem;
  font-weight: 600;
  font-size: 0.875rem;
  transition: 0.15s ease;
}

.btn-primary {
  background: var(--btn-primary);
  color: white;
  flex: 1;
  box-shadow: var(--shadow-accent);
}

.btn-primary:hover {
  filter: brightness(1.08);
  transform: translateY(-1px);
}

.btn-ghost {
  background: var(--sidebar-item-hover);
  color: var(--sidebar-item);
}

.btn-ghost:hover {
  background: var(--sidebar-item-active-bg);
}

.sidebar-tabs {
  display: flex;
  gap: 0.35rem;
  padding: 0 1rem 0.75rem;
}

.tab {
  flex: 1;
  background: transparent;
  border: 1px solid transparent;
  color: var(--text-muted-inv);
  border-radius: 8px;
  padding: 0.45rem;
  font-size: 0.8rem;
  font-weight: 600;
}

.tab.active {
  background: var(--sidebar-item-active-bg);
  border-color: var(--sidebar-item-active-border);
  color: var(--text-inverse);
}

.sidebar-list {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  padding: 0 0.65rem 1rem;
  overscroll-behavior: contain;
}

.list-item {
  width: 100%;
  text-align: left;
  background: transparent;
  border: 1px solid transparent;
  color: var(--sidebar-item);
  border-radius: 10px;
  padding: 0.55rem 0.45rem 0.55rem 0.75rem;
  margin-bottom: 0.35rem;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 0.35rem;
  transition: background 0.15s ease, border-color 0.15s ease;
  position: relative;
}

.list-item:hover {
  background: var(--sidebar-item-hover);
}

.list-item.active {
  background: var(--sidebar-item-active-bg);
  border-color: var(--sidebar-item-active-border);
}

.list-item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
}

.list-item-title {
  font-size: 0.85rem;
  font-weight: 600;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.list-item-meta {
  font-size: 0.72rem;
  color: var(--text-muted-inv);
}

.main-panel {
  display: flex;
  flex-direction: column;
  background:
    radial-gradient(ellipse 80% 50% at 10% -10%, var(--bg-chat-mesh-a), transparent 55%),
    radial-gradient(ellipse 70% 45% at 100% 0%, var(--bg-chat-mesh-b), transparent 50%),
    var(--bg-chat);
  min-width: 0;
  min-height: 0;
  height: 100%;
  overflow: hidden;
  position: relative;
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.75rem;
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--border);
  background: var(--bg-surface);
  backdrop-filter: blur(14px);
  flex-shrink: 0;
  flex-wrap: wrap;
}

.chat-header-actions {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-shrink: 0;
}

.chat-header-brand {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  min-width: 0;
  flex: 1;
}

.chat-header-brand img {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  object-fit: contain;
  background: white;
  padding: 3px;
  flex-shrink: 0;
}

.chat-header-brand > div {
  min-width: 0;
}

.chat-header h2 {
  margin: 0;
  font-size: 1rem;
  font-weight: 700;
  font-family: var(--font-display);
  letter-spacing: -0.02em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.chat-header p {
  margin: 0.2rem 0 0;
  font-size: 0.8rem;
  color: var(--text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--success);
  display: inline-block;
  margin-right: 0.4rem;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--success) 25%, transparent);
}

.chat-thread {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  overflow-x: hidden;
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
}

.empty-state {
  margin: auto;
  text-align: center;
  max-width: 480px;
  color: var(--text-secondary);
}

.empty-state h3 {
  color: var(--text-primary);
  margin: 0 0 0.5rem;
  font-size: 1.45rem;
  font-family: var(--font-display);
  letter-spacing: -0.03em;
}

.empty-state p {
  margin: 0;
}

.suggestion-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.65rem;
  margin-top: 1.25rem;
}

.suggestion {
  background: var(--bg-surface-solid);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 0.85rem;
  text-align: left;
  color: var(--text-primary);
  box-shadow: var(--shadow);
  transition: border-color 0.15s ease, transform 0.15s ease, background 0.15s ease;
}

.suggestion:hover {
  border-color: var(--accent);
  background: var(--accent-soft);
  transform: translateY(-2px);
}

.message-row {
  display: flex;
  gap: 0.75rem;
  max-width: 900px;
  width: 100%;
}

.message-row.user {
  margin-left: auto;
  flex-direction: row-reverse;
}

.avatar {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  display: grid;
