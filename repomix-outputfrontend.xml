}

.confirm-delete-dialog p {
  margin: 0.45rem 0 0;
  color: var(--text-secondary);
  line-height: 1.45;
}

.confirm-delete-actions {
  display: flex;
  justify-content: flex-end;
  gap: 0.5rem;
  margin-top: 1.15rem;
}

.confirm-delete-actions button {
  border-radius: 999px;
  padding: 0.45rem 0.9rem;
  font-weight: 700;
  cursor: pointer;
  border: 1px solid var(--border);
