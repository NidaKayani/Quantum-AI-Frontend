}

.theme-dialog-backdrop {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background: rgba(8, 12, 18, 0.58);
  backdrop-filter: blur(8px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: max(1.25rem, var(--safe-top)) max(1.25rem, var(--safe-right))
    max(1.25rem, var(--safe-bottom)) max(1.25rem, var(--safe-left));
  box-sizing: border-box;
}

.theme-dialog {
  width: min(520px, 100%);
  max-height: min(88dvh, 640px);
  display: flex;
  flex-direction: column;
  border-radius: 18px;
  border: 1px solid var(--border);
  background: var(--bg-surface-solid);
  box-shadow: 0 24px 64px rgba(0, 0, 0, 0.32);
  overflow: hidden;
  color: var(--text-primary);
  position: relative;
  z-index: 1;
  animation: login-rise 180ms ease both;
}

.theme-switcher--dialog .theme-swatch-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0.65rem;
}

.theme-swatch-logo {
