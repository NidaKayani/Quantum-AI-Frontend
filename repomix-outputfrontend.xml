/* ============================================
   v2.0 LAYOUT ADDITIONS
   ============================================ */

/* ----- Hero Section (replaces empty-state header) ----- */
.qa-hero {
  background: linear-gradient(135deg, var(--bg-panel), var(--bg-sidebar-end));
  padding: 48px 32px;
  text-align: center;
  color: var(--text-inverse);
  position: relative;
  overflow: hidden;
  border-radius: 20px;
  margin-bottom: 8px;
}
.qa-hero::before {
  content: '';
  position: absolute;
  top: -50%;
  left: -50%;
  width: 200%;
  height: 200%;
  background: radial-gradient(circle, var(--accent-glow) 0%, transparent 70%);
  animation: heroPulse 5s ease-in-out infinite;
}
@keyframes heroPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.15); }
}
.qa-hero-content {
  position: relative;
  z-index: 1;
}
.qa-hero-greeting {
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  opacity: 0.75;
  margin-bottom: 8px;
}
.qa-hero h3 {
  font-size: 1.45rem;
  font-family: var(--font-display);
  letter-spacing: -0.03em;
  margin: 0 0 8px;
  color: inherit;
}
.qa-hero p {
  font-size: 14px;
  opacity: 0.85;
  max-width: 420px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ----- Horizontal Chips (replaces 2×2 grid) ----- */
.qa-chips {
  display: flex;
  gap: 10px;
  padding: 12px 0 0;
  overflow-x: auto;
  scrollbar-width: none;
  justify-content: center;
  flex-wrap: wrap;
}
.qa-chips::-webkit-scrollbar { display: none; }
.qa-chip {
  background: var(--bg-surface-solid);
  border: 1px solid var(--border);
  border-radius: 20px;
  padding: 10px 18px;
  font-size: 13px;
  color: var(--text-secondary);
  white-space: nowrap;
  cursor: pointer;
  transition: all 0.2s;
  user-select: none;
  box-shadow: var(--shadow);
}
.qa-chip:hover {
  border-color: var(--accent);
  color: var(--accent);
  transform: translateY(-2px);
  box-shadow: 0 4px 12px var(--accent-glow);
}

/* ----- Floating Input Pill (Dark Glass) ----- */
.qa-input-pill {
  background: var(--bg-surface-solid);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 10px 14px 10px 18px;
  display: flex;
  align-items: flex-end;
  gap: 10px;
  box-shadow: var(--shadow);
  transition: border-color 0.15s ease, box-shadow 0.15s ease;
}
.qa-input-pill:focus-within {
  border-color: var(--accent);
  box-shadow: 0 0 0 3px var(--input-focus);
}
.qa-input-pill textarea {
  flex: 1;
  background: transparent;
  border: none;
  resize: none;
  outline: none;
  min-height: 24px;
  max-height: 160px;
  overflow-y: auto;
  line-height: 1.45;
  field-sizing: content;
  color: var(--text-primary);
  font: inherit;
}
.qa-input-pill textarea::placeholder {
  color: var(--text-secondary);
}
.qa-input-actions {
  display: flex;
  gap: 6px;
  align-items: center;
  padding-bottom: 2px;
}

/* Glass buttons — dark translucent */
.qa-input-btn {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid rgba(128, 128, 128, 0.18);
  display: grid;
  place-items: center;
  cursor: pointer;
  transition: all 0.2s;
  font-size: 16px;
  flex-shrink: 0;
  background: rgba(128, 128, 128, 0.08);
  color: var(--text-secondary);
}
.qa-input-btn:hover {
  background: rgba(128, 128, 128, 0.16);
  color: var(--text-primary);
  transform: translateY(-1px);
}


/* Send button — pops with gradient, slightly larger */
.qa-input-btn.send {
  width: 40px;
  height: 40px;
  background: var(--btn-primary);
  color: white;
  border-color: transparent;
  box-shadow: var(--shadow-accent);
  font-size: 18px;
}
.qa-input-btn.send:hover {
  transform: scale(1.08);
  filter: brightness(1.1);
}
.qa-input-btn.send:disabled {
  opacity: 0.5;
  cursor: not-allowed;
  transform: none;
  filter: none;
}

/* Active states — search, listening, stop — theme-aware, no hardcoded red */
.qa-input-btn.search-active,
.qa-input-btn.listening,
.qa-input-btn.stop {
  background: var(--accent-soft);
  color: var(--accent-text);
  border-color: var(--accent);
}
.qa-input-btn.listening {
  animation: micPulse 1.5s ease-in-out infinite;
}
@keyframes micPulse {
  0%, 100% { box-shadow: 0 0 0 0 var(--accent-glow); }
  50% { box-shadow: 0 0 0 6px transparent; }
}
.qa-input-btn.stop {
  animation: none;
}

/* ----- MessageBubble action buttons ----- */
.msg-action-btn {
  padding: 6px 12px;
  border: none;
  border-radius: 8px;
  cursor: pointer;
  font-size: 14px;
  font-weight: 600;
  transition: filter 0.15s ease, transform 0.15s ease;
}
.msg-action-btn:hover {
  filter: brightness(1.1);
  transform: translateY(-1px);
}
.msg-action-btn--primary {
  background: var(--btn-primary);
  color: white;
  box-shadow: var(--shadow-accent);
}
.msg-action-btn--secondary {
  background: linear-gradient(135deg, var(--accent-2, var(--accent)), var(--accent-hover));
  color: white;
  box-shadow: var(--shadow-accent);
}

[data-theme="pearl"] .qa-hero {
  background: linear-gradient(135deg, #ccfbf1, #99f6e4, #e0f2fe);
  color: #0f172a;
}
[data-theme="pearl"] .qa-hero::before {
  background: radial-gradient(circle, rgba(20, 184, 166, 0.12) 0%, transparent 70%);
}

@media (max-width: 600px) {
  .qa-hero {
    padding: 28px 20px;
    border-radius: 16px;
  }
  .qa-hero h3 {
    font-size: 1.15rem;
  }
  .qa-hero p {
    font-size: 13px;
  }
  .qa-chips {
    padding: 12px 0 0;
    gap: 8px;
  }
  .qa-chip {
    padding: 8px 14px;
    font-size: 12px;
  }
  .qa-input-pill {
    padding: 8px 12px 8px 14px;
  }
  .qa-input-btn {
    width: 34px;
    height: 34px;
  }
  .qa-input-btn.send {
    width: 38px;
    height: 38px;
  }
}

/* ============================================
   MOBILE RESPONSIVE FIXES
   ============================================ */

@media (max-width: 900px) {
  /* Force single column */
  .app-shell {
    grid-template-columns: 1fr !important;
  }

  /* Hide sidebar by default on mobile */
  .sidebar {
    display: none !important;
  }

  /* Sidebar only shows as fixed overlay when .open */
  .sidebar.open {
    display: flex !important;
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    z-index: 50;
    width: min(320px, 88vw);
    height: 100dvh;
    box-shadow: 8px 0 32px rgba(0, 0, 0, 0.35);
  }

  /* Main panel takes full width */
  .main-panel {
    width: 100%;
    min-width: 0;
  }

  /* Ensure hamburger is visible */
  .mobile-menu-btn {
    display: inline-grid !important;
  }

  /* Hero scales down */
  .qa-hero {
    padding: 32px 20px;
    margin: 0 0.5rem 8px;
  }
  .qa-hero h3 {
    font-size: 1.25rem;
  }

  /* Chips wrap and shrink */
  .qa-chips {
    padding: 12px 0.5rem 0;
    gap: 8px;
    justify-content: flex-start;
  }
  .qa-chip {
    padding: 8px 14px;
    font-size: 12px;
  }

  /* Input pill compact */
  .qa-input-pill {
    padding: 8px 12px 8px 14px;
    margin: 0 0.5rem;
  }
  .qa-input-btn {
    width: 34px;
    height: 34px;
  }
  .qa-input-btn.send {
    width: 38px;
    height: 38px;
  }

  /* Header compact */
  .chat-header {
    padding: 0.75rem 0.9rem;
  }
  .chat-header-brand img {
    width: 32px;
    height: 32px;
  }
}

@media (max-width: 600px) {
  .qa-hero {
    padding: 24px 16px;
    border-radius: 16px;
  }
  .qa-hero h3 {
    font-size: 1.1rem;
  }
  .qa-hero p {
    font-size: 12px;
  }
  .qa-chip {
    font-size: 11px;
    padding: 6px 12px;
  }
  .suggestion-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 400px) {
  .chat-header-brand img {
    display: none;
  }
  .qa-input-pill textarea {
    font-size: 16px; /* Prevent iOS zoom */
  }
}

/* adding error boundary styles */
.error-boundary {
  max-width: 480px;
  margin: 15vh auto;
  padding: 32px;
  text-align: center;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 16px;
  color: var(--text);
}

.error-boundary h2 {
  margin: 0 0 12px;
  font-size: 20px;
}

.error-boundary p {
  color: var(--text-muted);
  font-size: 14px;
  line-height: 1.6;
  margin: 0 0 20px;
}

.error-boundary-detail {
  text-align: left;
  font-size: 12px;
  background: var(--bg-app);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px;
  overflow-x: auto;
  color: var(--danger);
  margin: 0 0 20px;
}

.error-boundary-actions {
  display: flex;
  gap: 10px;
  justify-content: center;
}

.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
