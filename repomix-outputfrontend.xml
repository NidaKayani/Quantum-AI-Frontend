  letter-spacing: 0.02em;
  cursor: pointer;
  transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
}

.theme-menu-trigger:hover,
.theme-menu-trigger[aria-expanded='true'] {
  background: var(--bg-muted);
  color: var(--text-primary);
  border-color: color-mix(in srgb, var(--accent) 35%, var(--border));
}

.theme-menu--login .theme-menu-trigger {
  background: color-mix(in srgb, var(--bg-surface-solid) 18%, transparent);
  border-color: color-mix(in srgb, var(--login-brand) 35%, transparent);
  color: var(--text-inverse);
  backdrop-filter: blur(8px);
}

[data-theme='pearl'] .theme-menu--login .theme-menu-trigger {
  background: rgba(255, 255, 255, 0.85);
  color: var(--text-primary);
  border-color: var(--border);
}

.theme-menu-dropdown {
  position: absolute;
  top: calc(100% + 6px);
  right: 0;
  min-width: 10rem;
  padding: 0.35rem;
  border-radius: 12px;
  border: 1px solid var(--border);
  background: var(--bg-surface-solid);
  box-shadow: var(--shadow);
