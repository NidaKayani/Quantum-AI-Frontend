}

.theme-switcher--dialog .theme-swatch-preview {
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 12px;
  margin-bottom: 0.25rem;
  display: grid;
  place-items: center;
}

.theme-switcher--dialog .theme-swatch-dot {
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-size: 0.7rem;
  font-weight: 800;
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
}

.theme-switcher--dialog .theme-swatch-name {
  font-size: 0.8rem;
  font-weight: 700;
}

.theme-switcher--dialog .theme-swatch-desc {
  font-size: 0.65rem;
