/* —— Theme menu (⋯) + dialog —— */
.theme-menu {
  position: relative;
  flex-shrink: 0;
}

.theme-menu-trigger {
  width: 2.35rem;
  height: 2.35rem;
  border: 1px solid var(--border);
  border-radius: 10px;
  background: var(--bg-surface-solid);
  color: var(--text-secondary);
  display: grid;
  place-items: center;
  font-size: 1.35rem;
